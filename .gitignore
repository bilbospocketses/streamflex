# Out-of-source build directory used by docs/compilation.md
/build/
# Results of the headless checks, as CONTRIBUTING.md runs them
/headless-out/
docs/Gemfile.lock
docs/_site
docs/.jekyll-cache
# Written by pages.yml from the latest release at build time
docs/_data/release.json
# Intermediate frames and the packed .ico from branding/icon/build-icon.ps1
branding/icon/build/
# Written by branding/library/build-gallery.py when the site is built
docs/icons.md
docs/assets/library/
# Python caches and review output from branding/library tools
branding/library/__pycache__/
branding/library/build/
# Python caches from the tests/qa smoke lint
tests/qa/__pycache__/
# Python caches from the headless harness's merge.py
tests/headless/__pycache__/
# The Phase 0 probe kit's build tree, extension packages and Python caches
/build-phase0/
tools/overlay-phase0/extension/dist/
tools/overlay-phase0/tests/__pycache__/
tools/overlay-phase0/setup/__pycache__/
